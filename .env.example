# Copy this file to `.env` (same directory) and fill in your real secrets.
#
# `.env` is gitignored and is only ever loaded into the `proxy` container
# (see docker-compose.yml `env_file`). The `agent` container never receives
# these values - it only ever sees a placeholder. The proxy injects the real
# value into outgoing requests for the hosts configured in
# container/proxy/rules.yaml.
#
# After editing this file, restart the proxy so it picks up the new value:
#   docker compose up -d --force-recreate proxy

# Anthropic API key used for Claude Code.
# Injected as the `x-api-key` header for requests to api.anthropic.com.
ANTHROPIC_API_KEY=
